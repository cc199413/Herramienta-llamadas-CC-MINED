# Copia este archivo a ".env" y completa con tus valores reales.
# NUNCA subas el archivo ".env" (con las claves reales) a un repositorio.

# --- Google Sheets ---
# JSON completo de la cuenta de servicio, en una sola línea (ver README para cómo obtenerlo).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ID de la hoja: es la parte de la URL entre /d/ y /edit
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Nombre de la pestaña y rango de columnas donde están los datos
GOOGLE_SHEET_RANGE=Centros!A1:Z

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Service role key (Project Settings > API > service_role).
# Esta clave tiene permisos totales: úsala SOLO en este script (servidor),
# nunca en el navegador ni en el frontend de la app.
SUPABASE_SERVICE_ROLE_KEY=
